
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py .
COPY embeddings.py .
COPY vector_store.py .
COPY document_loader.py .
COPY chunker.py .
COPY admin.py .

EXPOSE 8080

CMD ["sh", "-c", "streamlit run admin.py --server.address 0.0.0.0 --server.port ${PORT} --server.headless true"]
